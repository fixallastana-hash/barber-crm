{
  "hosting": [
    {
      "target": "admin",
      "public": "web-admin/out",
      "ignore": ["firebase.json", "/.*", "/node_modules/**"],
      "cleanUrls": true
    },
    {
      "target": "widget",
      "public": "web-widget/out",
      "ignore": ["firebase.json", "/.*", "/node_modules/**"],
      "cleanUrls": true
    }
  ],
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}