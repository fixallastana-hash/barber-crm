rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasTenant(tenantId) {
      return request.auth != null && request.auth.token.tenantId == tenantId;
    }
    function isOwner(tenantId) {
      return hasTenant(tenantId) && request.auth.token.role == 'owner';
    }
    function isOwnerOrAdmin(tenantId) {
      return hasTenant(tenantId) &&
        (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }

    match /slugRegistry/{slug} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      allow read, write: if false;

      match /config/info {
        allow read: if true;
        allow write: if isOwnerOrAdmin(tenantId);
      }

      match /branches/{branchId} {
        allow read: if hasTenant(tenantId);
        allow write: if false;
      }

      match /masters/{masterId} {
        allow read: if isOwnerOrAdmin(tenantId);
        allow write: if false;

        match /private/{doc} {
          allow read: if isOwner(tenantId);
          allow write: if false;
        }
      }

      match /categories/{categoryId} {
        allow read: if hasTenant(tenantId);
        allow write: if false;
      }

      match /services/{serviceId} {
        allow read: if hasTenant(tenantId);
        allow write: if false;
      }

      match /clients/{clientId} {
        allow read: if isOwnerOrAdmin(tenantId);
        allow write: if false;
      }

      match /clientPhoneIndex/{phone} {
        allow read, write: if false;
      }

      match /users/{userId} {
        allow read: if isOwner(tenantId) || (request.auth.uid == userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(tenantId) || isOwnerOrAdmin(tenantId);
        allow write: if false;
      }

      match /reviews/{reviewId} {
        allow read: if isOwnerOrAdmin(tenantId);
        allow write: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if isOwnerOrAdmin(tenantId);
        allow write: if false;
      }

      match /ledger/{ledgerId} {
        allow read, write: if false;
      }

      match /financialLedger/{entryId} {
        allow read: if isOwnerOrAdmin(tenantId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}