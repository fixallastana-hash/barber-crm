{
  "name": "barber-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:admin": "pnpm --filter web-admin dev",
    "dev:widget": "pnpm --filter web-widget dev",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter web-admin build",
    "build:widget": "pnpm --filter web-widget build",
    "build:functions": "pnpm --filter functions build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:admin": "firebase deploy --only hosting:admin",
    "deploy:widget": "firebase deploy --only hosting:widget",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "firebase deploy",
    "test:rules": "pnpm exec firebase emulators:exec --only firestore --project barber-crm-dev \"vitest run tests/rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.6.2",
    "vitest": "^5.0.3"
  }
}
