# ============================================
# Firebase web app config (те же значения, что в web-admin)
# Получить: Firebase Console → Project settings → Your apps → Web app
# ============================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# Functions region (optional)
# Default: asia-east1
# ============================================

NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-east1

# App Check (reCAPTCHA Enterprise) site key
# Firebase Console -> App Check -> Barber CRM Widget
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
